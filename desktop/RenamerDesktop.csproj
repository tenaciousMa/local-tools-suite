<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>FileRenamerDesktop</AssemblyName>
    <RootNamespace>RenamerDesktop</RootNamespace>
    <ApplicationIcon>../assets/app-icon.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="../assets/app-icon.ico" Link="assets/app-icon.ico" />
    <Compile Remove="video\**\*.cs" />
    <Page Remove="video\**\*.xaml" />
    <ApplicationDefinition Remove="video\**\*.xaml" />
  </ItemGroup>
</Project>

<Window x:Class="RenamerDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件改名台"
        Width="1240"
        Height="780"
        MinWidth="1020"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#EDF1F5"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17202B" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#3D4C60" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="TokenButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#ECF0F5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="#17202B" />
            <Setter Property="ColumnHeaderHeight" Value="36" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Height="58"
                Background="White"
                BorderBrush="#D8E0E9"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="8"
                            Background="#2563EB"
                            Margin="0,0,10,0">
                        <TextBlock Text="名"
                                   Foreground="White"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="文件改名台"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="原生本地应用"
                               Foreground="#64758A"
                               FontSize="12"
                               Margin="12,5,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Height="62"
                Background="#F5F8FB"
                BorderBrush="#D8E0E9"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#64758A"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="ApplyButton"
                        Grid.Column="1"
                        Content="一键改名"
                        Style="{StaticResource PrimaryButton}"
                        Click="ApplyButton_Click" />
            </Grid>
        </Border>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="375" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D8E0E9"
                    BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16">
                    <StackPanel>
                        <TextBlock Text="处理模式"
                                   Style="{StaticResource GroupLabel}" />
                        <Border Background="#F5F8FB"
                                BorderBrush="#D8E0E9"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,7"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <RadioButton x:Name="DirectModeRadio"
                                             GroupName="ActionMode"
                                             Content="直接改源文件"
                                             IsChecked="True"
                                             Checked="ModeChanged"
                                             Unchecked="ModeChanged" />
                                <RadioButton x:Name="ZipModeRadio"
                                             GroupName="ActionMode"
                                             Content="导出 ZIP 副本（不改原文件）"
                                             Margin="0,6,0,0"
                                             Checked="ModeChanged"
                                             Unchecked="ModeChanged" />
                                <RadioButton x:Name="OpenFolderYesRadio"
                                             GroupName="AfterAction"
                                             Content="改名后打开原文件夹"
                                             Margin="0,8,0,0"
                                             IsChecked="True"
                                             Checked="ModeChanged"
                                             Unchecked="ModeChanged" />
                                <RadioButton x:Name="OpenFolderNoRadio"
                                             GroupName="AfterAction"
                                             Content="改名后不打开原文件夹"
                                             Margin="0,5,0,0"
                                             Checked="ModeChanged"
                                             Unchecked="ModeChanged" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="文件来源"
                                   Style="{StaticResource GroupLabel}" />
                        <WrapPanel>
                            <Button x:Name="AddFilesButton"
                                    Content="添加文件"
                                    Style="{StaticResource ActionButton}"
                                    Click="AddFilesButton_Click" />
                            <Button x:Name="AddFolderButton"
                                    Content="添加文件夹"
                                    Style="{StaticResource ActionButton}"
                                    Click="AddFolderButton_Click" />
                            <Button x:Name="ClearButton"
                                    Content="一键清空"
                                    Style="{StaticResource ActionButton}"
                                    Click="ClearButton_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="SourceSummary"
                                   Text="尚未选择文件"
                                   Margin="0,10,0,0"
                                   Foreground="#64758A"
                                   FontSize="12"
                                   TextWrapping="Wrap" />

                        <Border Height="1"
                                Background="#D8E0E9"
                                Margin="0,16,0,16" />

                        <TextBlock Text="自定义模板"
                                   Style="{StaticResource GroupLabel}" />
                        <TextBox x:Name="FormulaBox"
                                 Height="62"
                                 Text="{}{date}_{num}"
                                 AcceptsReturn="False"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 TextChanged="RuleChanged" />
                        <TextBlock Text="可直接输入任意文字，再点击插入日期、时间、序号或原名"
                                   Foreground="#8A97A8"
                                   FontSize="11"
                                   Margin="0,5,0,8" />
                        <WrapPanel>
                            <Button Content="数字日期"
                                    Tag="{}{YYYY}-{MM}-{DD}"
                                    Style="{StaticResource TokenButton}"
                                    Click="InsertToken_Click" />
                            <Button Content="中文日期"
                                    Tag="{}{YYYY}年{MM}月{DD}日"
                                    Style="{StaticResource TokenButton}"
                                    Click="InsertToken_Click" />
                            <Button Content="完整日期"
                                    Tag="{}{date}"
                                    Style="{StaticResource TokenButton}"
                                    Click="InsertToken_Click" />
                            <Button Content="时间"
                                    Tag="{}{HH}时{mm}分"
                                    Style="{StaticResource TokenButton}"
                                    Click="InsertToken_Click" />
                            <Button Content="序号"
                                    Tag="{}{num}"
                                    Style="{StaticResource TokenButton}"
                                    Click="InsertToken_Click" />
                            <Button Content="原名"
                                    Tag="{}{name}"
                                    Style="{StaticResource TokenButton}"
                                    Click="InsertToken_Click" />
                        </WrapPanel>

                        <TextBlock Text="常用组合"
                                   Style="{StaticResource GroupLabel}"
                                   Margin="0,10,0,6" />
                        <WrapPanel>
                            <Button Content="日期 + 序号"
                                    Tag="{}{date}_{num}"
                                    Style="{StaticResource TokenButton}"
                                    Click="Preset_Click" />
                            <Button Content="日期 + 原名"
                                    Tag="{}{date}_{name}"
                                    Style="{StaticResource TokenButton}"
                                    Click="Preset_Click" />
                            <Button Content="原名 + 日期"
                                    Tag="{}{name}_{date}"
                                    Style="{StaticResource TokenButton}"
                                    Click="Preset_Click" />
                            <Button Content="序号 + 原名"
                                    Tag="{}{num}_{name}"
                                    Style="{StaticResource TokenButton}"
                                    Click="Preset_Click" />
                        </WrapPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="日期取"
                                           Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="DateSourceCombo"
                                          SelectionChanged="RuleChanged">
                                    <ComboBoxItem Content="文件修改时间" Tag="modified" IsSelected="True" />
                                    <ComboBoxItem Content="当前时间" Tag="now" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="日期格式"
                                           Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="DateFormatCombo"
                                          SelectionChanged="RuleChanged">
                                    <ComboBoxItem Content="2026-09-09" Tag="yyyy-MM-dd" />
                                    <ComboBoxItem Content="20260909" Tag="yyyyMMdd" />
                                    <ComboBoxItem Content="2026-09-09_14-30-00" Tag="yyyy-MM-dd_HH-mm-ss" IsSelected="True" />
                                    <ComboBoxItem Content="20260909_143000" Tag="yyyyMMdd_HHmmss" />
                                    <ComboBoxItem Content="2026年09月09日" Tag="yyyy年MM月dd日" />
                                    <ComboBoxItem Content="2026年09月09日_14时30分00秒" Tag="yyyy年MM月dd日_HH时mm分ss秒" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="起始序号"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="StartNumberBox"
                                         Text="1"
                                         TextChanged="RuleChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="序号位数"
                                           Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="PadCombo"
                                          SelectionChanged="RuleChanged">
                                    <ComboBoxItem Content="不补零" Tag="0" />
                                    <ComboBoxItem Content="2 位" Tag="2" IsSelected="True" />
                                    <ComboBoxItem Content="3 位" Tag="3" />
                                    <ComboBoxItem Content="4 位" Tag="4" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,12,0,0">
                            <CheckBox x:Name="StripCheckBox"
                                      Content="清理 (1) / 副本 等标记"
                                      Checked="RuleChanged"
                                      Unchecked="RuleChanged" />
                            <CheckBox x:Name="LowerCheckBox"
                                      Content="原名转为小写"
                                      Checked="RuleChanged"
                                      Unchecked="RuleChanged" />
                        </StackPanel>

                        <Button Content="还原默认规则"
                                Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0"
                                Click="ResetRuleButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D8E0E9"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="#D8E0E9"
                            BorderThickness="0,0,0,1"
                            Padding="14,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="改名预览"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <Border x:Name="PreviewCountBadge"
                                        MinWidth="24"
                                        Height="20"
                                        CornerRadius="10"
                                        Background="#F5F8FB"
                                        BorderBrush="#D8E0E9"
                                        BorderThickness="1"
                                        Margin="8,0,0,0">
                                    <TextBlock x:Name="PreviewCountText"
                                               Text="0"
                                               Foreground="#64758A"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <CheckBox x:Name="ChangedOnlyCheckBox"
                                      Content="只看将改名"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Checked="RuleChanged"
                                      Unchecked="RuleChanged" />
                        </Grid>
                    </Border>
                    <DataGrid x:Name="FileGrid"
                              Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"
                                                Binding="{Binding Order}"
                                                Width="48" />
                            <DataGridTextColumn Header="原文件名"
                                                Binding="{Binding OriginalName}"
                                                Width="1.1*" />
                            <DataGridTextColumn Header="所在文件夹"
                                                Binding="{Binding DirectoryPath}"
                                                Width="1.5*" />
                            <DataGridTextColumn Header="修改时间"
                                                Binding="{Binding TimeText}"
                                                Width="140" />
                            <DataGridTextColumn Header="改名后"
                                                Binding="{Binding TargetName}"
                                                Width="1.2*" />
                            <DataGridTextColumn Header="状态"
                                                Binding="{Binding StatusText}"
                                                Width="86" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>

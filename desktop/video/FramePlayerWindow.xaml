<Window x:Class="VideoGridDesktop.FramePlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="视频播放器 - 手动选帧"
        Width="1080"
        Height="680"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Icon="assets/video-icon.ico"
        Background="#F1F5F9"
        ShowInTaskbar="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="RootGrid" Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border x:Name="VideoSurfaceBorder"
                Grid.Column="0"
                Background="#0F172A"
                CornerRadius="8"
                Padding="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="112" />
                </Grid.RowDefinitions>
                <vlc:VideoView x:Name="PlayerView"
                               Grid.Row="0" />
                <Border x:Name="PlaybackControlsBorder"
                        Grid.Row="1"
                        Background="#0F172A"
                        BorderBrush="#293548"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Slider x:Name="SeekSlider"
                                Grid.Row="0"
                                Minimum="0"
                                Maximum="1"
                                Value="0"
                                IsMoveToPointEnabled="True"
                                PreviewMouseDown="SeekSlider_PreviewMouseDown"
                                PreviewMouseUp="SeekSlider_PreviewMouseUp"
                                ValueChanged="SeekSlider_ValueChanged" />
                        <Grid Grid.Row="1">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Button x:Name="PlayButton"
                                        Content="播放"
                                        Padding="8,0"
                                        ToolTip="播放（空格或 K）"
                                        Style="{StaticResource ActionButton}"
                                        Click="PlayButton_Click" />
                                <Button x:Name="PauseButton"
                                        Content="暂停"
                                        Padding="8,0"
                                        ToolTip="暂停（空格或 K）"
                                        Style="{StaticResource ActionButton}"
                                        Click="PauseButton_Click" />
                                <Button Content="-10s"
                                        Padding="8,0"
                                        ToolTip="后退 10 秒（J）"
                                        Style="{StaticResource ActionButton}"
                                        Click="JumpBackButton_Click" />
                                <Button Content="+10s"
                                        Padding="8,0"
                                        ToolTip="前进 10 秒（L）"
                                        Style="{StaticResource ActionButton}"
                                        Click="JumpForwardButton_Click" />
                                <Button x:Name="MuteButton"
                                        Content="静音"
                                        Padding="8,0"
                                        ToolTip="静音（M）"
                                        Style="{StaticResource ActionButton}"
                                        Click="MuteButton_Click" />
                                <TextBlock Text="音量"
                                           Foreground="#CBD5E1"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="2,0,4,0" />
                                <Slider x:Name="VolumeSlider"
                                        Width="76"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="100"
                                        VerticalAlignment="Center"
                                        ValueChanged="VolumeSlider_ValueChanged" />
                                <Button x:Name="FullscreenButton"
                                        Content="全屏"
                                        Padding="8,0"
                                        Margin="8,0,8,0"
                                        ToolTip="全屏（F）"
                                        Style="{StaticResource ActionButton}"
                                        Click="FullscreenButton_Click" />
                                <TextBlock x:Name="TimeText"
                                           Text="00:00 / 00:00"
                                           Foreground="#CBD5E1"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="PlayerStatusText"
                                   Grid.Row="2"
                                   Text="空格/K 播放暂停 · ←/→ 5秒 · J/L 10秒 · ↑/↓ 音量 · M 静音 · F 全屏"
                                   Foreground="#64748B"
                                   FontSize="11"
                                   HorizontalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="SidePanel"
                Grid.Column="2"
                Background="White"
                BorderBrush="#D8E0E9"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="手动截图时间点"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <TextBlock Text="添加后会按时间顺序排列，并参与自动分页"
                           Foreground="#8A97A8"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <ListBox x:Name="FrameListBox"
                         Grid.Row="2"
                         Margin="0,0,0,8" />
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="添加当前帧"
                            Style="{StaticResource ActionButton}"
                            Click="AddFrameButton_Click" />
                    <Button Grid.Column="2"
                            Content="删除所选"
                            Style="{StaticResource ActionButton}"
                            Click="DeleteFrameButton_Click" />
                    <Button Grid.Column="4"
                            Content="清空"
                            Style="{StaticResource ActionButton}"
                            Click="ClearFramesButton_Click" />
                </Grid>
                <Button Grid.Row="3"
                        Content="完成，使用这些时间点"
                        Style="{StaticResource PrimaryButton}"
                        Height="40"
                        VerticalAlignment="Bottom"
                        Margin="0,64,0,0"
                        Click="DoneButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>

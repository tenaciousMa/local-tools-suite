<Window x:Class="VideoGridDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="视频截图拼图台"
        Width="1360"
        Height="860"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="assets/video-icon.ico"
        Background="#EDF1F5"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17202B" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#3D4C60" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8A97A8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="TokenButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#ECF0F5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="#17202B" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                Height="58"
                Background="White"
                BorderBrush="#D8E0E9"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="36"
                           Height="36"
                           Margin="0,0,10,0"
                           Source="assets/video-icon.png"
                           Stretch="Uniform" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="视频截图拼图台"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="本地视频等分取帧，自动拼成一张大图"
                                   Foreground="#64758A"
                                   FontSize="11"
                                   Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Height="62"
                Background="#F5F8FB"
                BorderBrush="#D8E0E9"
                BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="#64758A"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="CancelButton"
                            Content="取消"
                            Style="{StaticResource ActionButton}"
                            Visibility="Collapsed"
                            Click="CancelButton_Click" />
                    <Button x:Name="PreviewButton"
                            Content="预览当前视频"
                            ToolTip="预览当前视频（Ctrl+P）"
                            Style="{StaticResource ActionButton}"
                            IsEnabled="False"
                            Click="PreviewButton_Click" />
                    <Button x:Name="ExportButton"
                            Content="批量导出截图"
                            ToolTip="批量导出（Ctrl+E 或 Ctrl+Enter）"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="False"
                            Click="ExportButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="408" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D8E0E9"
                    BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16">
                    <StackPanel>
                        <TextBlock Text="视频来源"
                                   Style="{StaticResource GroupLabel}" />
                        <WrapPanel>
                            <Button x:Name="AddVideoButton"
                                    Content="添加视频"
                                    ToolTip="添加视频（Ctrl+O）"
                                    Style="{StaticResource ActionButton}"
                                    Click="AddVideoButton_Click" />
                            <Button x:Name="AddFolderButton"
                                    Content="添加文件夹"
                                    ToolTip="添加文件夹（Ctrl+Shift+O）"
                                    Style="{StaticResource ActionButton}"
                                    Click="AddFolderButton_Click" />
                            <Button x:Name="ClearButton"
                                    Content="清空列表"
                                    Style="{StaticResource ActionButton}"
                                    Click="ClearButton_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="SourceSummary"
                                   Text="支持把多个视频文件或文件夹拖进窗口"
                                   Style="{StaticResource HintText}"
                                   Margin="0,0,0,2" />

                        <Border Height="1"
                                Background="#D8E0E9"
                                Margin="0,14,0,14" />

                        <TextBlock Text="画面排版"
                                   Style="{StaticResource GroupLabel}" />
                        <TextBlock Text="每页格数"
                                   Style="{StaticResource FieldLabel}" />
                        <WrapPanel x:Name="FramePresetPanel" />
                        <StackPanel x:Name="CustomCountPanel"
                                    Orientation="Horizontal"
                                    Margin="0,0,0,8"
                                    Visibility="Collapsed">
                            <TextBlock Text="自定义张数"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBox x:Name="CustomCountBox"
                                     Width="86"
                                     Text="10"
                                     InputMethod.IsInputMethodEnabled="False" />
                            <Button Content="应用"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource TokenButton}"
                                    Click="ApplyCustomCount_Click" />
                        </StackPanel>
                        <TextBlock x:Name="LayoutHint"
                                   Style="{StaticResource HintText}"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="单视频总截图数（0 = 每页格数）"
                                   Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TotalFramesBox"
                                 Text="0"
                                 Margin="0,0,0,10"
                                 TextChanged="SettingsChanged" />

                        <TextBlock Text="画格比例"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="AspectCombo"
                                  SelectionChanged="SettingsChanged">
                            <ComboBoxItem Content="跟随视频原比例" Tag="original" IsSelected="True" />
                            <ComboBoxItem Content="统一 16:9" Tag="16x9" />
                            <ComboBoxItem Content="统一 4:3" Tag="4x3" />
                            <ComboBoxItem Content="统一 1:1 方形" Tag="square" />
                        </ComboBox>

                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="大图尺寸"
                                       Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="SizePresetCombo"
                                      SelectionChanged="SettingsChanged">
                                <ComboBoxItem Content="自动适应排版" Tag="auto" IsSelected="True" />
                                <ComboBoxItem Content="1080P  1920 x 1080" Tag="1080p" />
                                <ComboBoxItem Content="2K     2560 x 1440" Tag="2k" />
                                <ComboBoxItem Content="4K     3840 x 2160" Tag="4k" />
                                <ComboBoxItem Content="8K     7680 x 4320" Tag="8k" />
                                <ComboBoxItem Content="16K    15360 x 8640" Tag="16k" />
                                <ComboBoxItem Content="A4 竖版 2480 x 3508" Tag="a4v" />
                                <ComboBoxItem Content="A4 横版 3508 x 2480" Tag="a4h" />
                                <ComboBoxItem Content="A3 竖版 3508 x 4961" Tag="a3v" />
                                <ComboBoxItem Content="A3 横版 4961 x 3508" Tag="a3h" />
                            </ComboBox>
                        </StackPanel>

                        <Border Height="1"
                                Background="#D8E0E9"
                                Margin="0,14,0,14" />

                        <TextBlock Text="大标题与小字"
                                   Style="{StaticResource GroupLabel}" />
                        <CheckBox x:Name="BigTitleCheckBox"
                                  Content="显示大标题"
                                  IsChecked="True"
                                  Checked="SettingsChanged"
                                  Unchecked="SettingsChanged" />
                        <TextBox x:Name="BigTitleBox"
                                 Text="{}{name}"
                                 Margin="0,2,0,5"
                                 TextChanged="SettingsChanged" />
                        <WrapPanel>
                            <Button Content="{}{name}"
                                    Tag="{}{name}"
                                    Style="{StaticResource TokenButton}"
                                    Click="TitleTokenClick" />
                            <Button Content="{}{date}"
                                    Tag="{}{date}"
                                    Style="{StaticResource TokenButton}"
                                    Click="TitleTokenClick" />
                            <Button Content="{}{num}"
                                    Tag="{}{num}"
                                    Style="{StaticResource TokenButton}"
                                    Click="TitleTokenClick" />
                            <Button Content="{}{duration}"
                                    Tag="{}{duration}"
                                    Style="{StaticResource TokenButton}"
                                    Click="TitleTokenClick" />
                        </WrapPanel>
                        <Grid Margin="0,5,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="标题字号"
                                           Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="BigTitleSizeCombo"
                                          SelectionChanged="SettingsChanged">
                                    <ComboBoxItem Content="28 px" Tag="28" />
                                    <ComboBoxItem Content="36 px" Tag="36" />
                                    <ComboBoxItem Content="44 px" Tag="44" IsSelected="True" />
                                    <ComboBoxItem Content="56 px" Tag="56" />
                                    <ComboBoxItem Content="72 px" Tag="72" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="小字字号"
                                           Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="CaptionSizeCombo"
                                          SelectionChanged="SettingsChanged">
                                    <ComboBoxItem Content="14 px" Tag="14" />
                                    <ComboBoxItem Content="18 px" Tag="18" />
                                    <ComboBoxItem Content="22 px" Tag="22" IsSelected="True" />
                                    <ComboBoxItem Content="28 px" Tag="28" />
                                    <ComboBoxItem Content="36 px" Tag="36" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="CaptionCheckBox"
                                  Content="每格显示小标题"
                                  IsChecked="True"
                                  Checked="SettingsChanged"
                                  Unchecked="SettingsChanged" />
                        <TextBox x:Name="CaptionBox"
                                 Text="{}{time}"
                                 Margin="0,2,0,5"
                                 TextChanged="SettingsChanged" />
                        <WrapPanel>
                            <Button Content="{}{time}"
                                    Tag="{}{time}"
                                    Style="{StaticResource TokenButton}"
                                    Click="CaptionTokenClick" />
                            <Button Content="{}{num}"
                                    Tag="{}{num}"
                                    Style="{StaticResource TokenButton}"
                                    Click="CaptionTokenClick" />
                            <Button Content="{}{name}"
                                    Tag="{}{name}"
                                    Style="{StaticResource TokenButton}"
                                    Click="CaptionTokenClick" />
                        </WrapPanel>
                        <StackPanel Margin="0,5,0,0">
                            <TextBlock Text="时间格式"
                                       Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="TimeFormatCombo"
                                      SelectionChanged="SettingsChanged">
                                <ComboBoxItem Content="01:23" Tag="mm:ss" IsSelected="True" />
                                <ComboBoxItem Content="00:01:23" Tag="HH:mm:ss" />
                                <ComboBoxItem Content="01:23.456" Tag="mm:ss.mmm" />
                                <ComboBoxItem Content="00:01:23.456" Tag="HH:mm:ss.mmm" />
                                <ComboBoxItem Content="1分23秒" Tag="mm分ss秒" />
                                <ComboBoxItem Content="00时01分23秒" Tag="HH时mm分ss秒" />
                            </ComboBox>
                        </StackPanel>

                        <Border Height="1"
                                Background="#D8E0E9"
                                Margin="0,14,0,14" />

                        <TextBlock Text="命名与导出"
                                   Style="{StaticResource GroupLabel}" />
                        <TextBlock Text="批量导出方式"
                                   Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ExportModeCombo"
                                  SelectionChanged="SettingsChanged">
                            <ComboBoxItem Content="单个视频分别导出" Tag="separate" IsSelected="True" />
                            <ComboBoxItem Content="所有视频合并导出" Tag="merged" />
                            <ComboBoxItem Content="分别导出 + 合并都做" Tag="both" />
                        </ComboBox>
                        <TextBlock x:Name="ExportModeHint"
                                   Text="每个视频生成自己的文件。"
                                   Style="{StaticResource HintText}"
                                   Margin="0,4,0,2" />
                        <TextBox x:Name="FormulaBox"
                                 Text="{}{name}_截图"
                                 Margin="0,10,0,0"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 TextChanged="SettingsChanged" />
                        <TextBlock Text="支持文字、日期、序号、原名等变量"
                                   Style="{StaticResource HintText}"
                                   Margin="0,4,0,7" />
                        <WrapPanel>
                            <Button Content="数字日期"
                                    Tag="{}{YYYY}-{MM}-{DD}"
                                    Style="{StaticResource TokenButton}"
                                    Click="FormulaTokenClick" />
                            <Button Content="完整日期"
                                    Tag="{}{date}"
                                    Style="{StaticResource TokenButton}"
                                    Click="FormulaTokenClick" />
                            <Button Content="时间"
                                    Tag="{}{time}"
                                    Style="{StaticResource TokenButton}"
                                    Click="FormulaTokenClick" />
                            <Button Content="序号"
                                    Tag="{}{num}"
                                    Style="{StaticResource TokenButton}"
                                    Click="FormulaTokenClick" />
                            <Button Content="原名"
                                    Tag="{}{name}"
                                    Style="{StaticResource TokenButton}"
                                    Click="FormulaTokenClick" />
                            <Button Content="时长"
                                    Tag="{}{duration}"
                                    Style="{StaticResource TokenButton}"
                                    Click="FormulaTokenClick" />
                        </WrapPanel>
                        <WrapPanel Margin="0,2,0,8">
                            <Button Content="日期 + 序号"
                                    Tag="{}{date}_{num}"
                                    Style="{StaticResource TokenButton}"
                                    Click="FormulaPresetClick" />
                            <Button Content="原名 + 序号"
                                    Tag="{}{name}_{num}"
                                    Style="{StaticResource TokenButton}"
                                    Click="FormulaPresetClick" />
                            <Button Content="原名_截图"
                                    Tag="{}{name}_截图"
                                    Style="{StaticResource TokenButton}"
                                    Click="FormulaPresetClick" />
                            <Button Content="日期 + 原名"
                                    Tag="{}{date}_{name}"
                                    Style="{StaticResource TokenButton}"
                                    Click="FormulaPresetClick" />
                        </WrapPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="日期取"
                                           Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="DateSourceCombo"
                                          SelectionChanged="SettingsChanged">
                                    <ComboBoxItem Content="视频修改时间" Tag="modified" IsSelected="True" />
                                    <ComboBoxItem Content="导出当前时间" Tag="now" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="日期格式"
                                           Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="DateFormatCombo"
                                          SelectionChanged="SettingsChanged">
                                    <ComboBoxItem Content="2026-09-09" Tag="yyyy-MM-dd" />
                                    <ComboBoxItem Content="20260909" Tag="yyyyMMdd" />
                                    <ComboBoxItem Content="2026-09-09_14-30-00" Tag="yyyy-MM-dd_HH-mm-ss" IsSelected="True" />
                                    <ComboBoxItem Content="20260909_143000" Tag="yyyyMMdd_HHmmss" />
                                    <ComboBoxItem Content="2026年09月09日" Tag="yyyy年MM月dd日" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="起始序号"
                                           Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="StartNumberBox"
                                         Text="1"
                                         TextChanged="SettingsChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="序号位数"
                                           Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="PadCombo"
                                          SelectionChanged="SettingsChanged">
                                    <ComboBoxItem Content="不补零" Tag="0" />
                                    <ComboBoxItem Content="2 位" Tag="2" IsSelected="True" />
                                    <ComboBoxItem Content="3 位" Tag="3" />
                                    <ComboBoxItem Content="4 位" Tag="4" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,10,0,0">
                            <CheckBox x:Name="StripCheckBox"
                                      Content="清理 (1) / 副本 等标记"
                                      Checked="SettingsChanged"
                                      Unchecked="SettingsChanged" />
                            <CheckBox x:Name="LowerCheckBox"
                                      Content="原名转为小写"
                                      Checked="SettingsChanged"
                                      Unchecked="SettingsChanged" />
                            <CheckBox x:Name="AutoSuffixCheckBox"
                                      Content="输出目录已有同名时追加序号"
                                      IsChecked="True"
                                      Checked="SettingsChanged"
                                      Unchecked="SettingsChanged" />
                            <CheckBox x:Name="OpenFolderCheckBox"
                                      Content="导出后打开输出文件夹"
                                      IsChecked="True" />
                        </StackPanel>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="导出格式"
                                           Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="OutputFormatCombo"
                                          SelectionChanged="SettingsChanged">
                                    <ComboBoxItem Content="PNG（清晰大图）" Tag="png" IsSelected="True" />
                                    <ComboBoxItem Content="JPG（体积更小）" Tag="jpg" />
                                    <ComboBoxItem Content="PDF（每页一张排版）" Tag="pdf" />
                                </ComboBox>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="选择导出文件夹"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource ActionButton}"
                                    Click="ChooseFolderButton_Click" />
                        </Grid>
                        <Border x:Name="OutputFolderBox"
                                Background="#F5F8FB"
                                BorderBrush="#D8E0E9"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="9,6"
                                Margin="0,8,0,0">
                            <TextBlock x:Name="OutputFolderText"
                                       Text="尚未选择，将保存到第一个视频所在目录"
                                       Foreground="#64758A"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </Border>

                        <Button Content="还原默认规则"
                                Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Click="ResetRuleButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#D8E0E9"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="#D8E0E9"
                            BorderThickness="0,0,0,1"
                            Padding="14,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="视频列表"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <Border x:Name="PreviewCountBadge"
                                        MinWidth="24"
                                        Height="20"
                                        CornerRadius="10"
                                        Background="#F5F8FB"
                                        BorderBrush="#D8E0E9"
                                        BorderThickness="1"
                                        Margin="8,0,0,0">
                                    <TextBlock x:Name="PreviewCountText"
                                               Text="0"
                                               Foreground="#64758A"
                                               FontSize="11"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="拖动视频文件到窗口可添加"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Foreground="#8A97A8"
                                       FontSize="11" />
                        </Grid>
                    </Border>

                    <DataGrid x:Name="VideoGrid"
                              Grid.Row="1"
                              SelectionChanged="VideoGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"
                                                Binding="{Binding Order}"
                                                Width="52" />
                            <DataGridTextColumn Header="视频"
                                                Binding="{Binding OriginalName}"
                                                Width="1.4*" />
                            <DataGridTextColumn Header="时长"
                                                Binding="{Binding DurationText}"
                                                Width="92" />
                            <DataGridTextColumn Header="分辨率"
                                                Binding="{Binding ResolutionText}"
                                                Width="110" />
                            <DataGridTextColumn Header="取帧"
                                                Binding="{Binding FrameSourceText}"
                                                Width="92" />
                            <DataGridTextColumn Header="导出文件名"
                                                Binding="{Binding TargetName}"
                                                Width="1.2*" />
                            <DataGridTextColumn Header="状态"
                                                Binding="{Binding StatusText}"
                                                Width="112" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3"
                            Background="#F5F8FB"
                            BorderBrush="#D8E0E9"
                            BorderThickness="0,1,0,0"
                            Padding="12,0,12,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="预览大图"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,0,9,0" />
                                    <ComboBox x:Name="PreviewVideoCombo"
                                              Width="300"
                                              DisplayMemberPath="OriginalName"
                                              VerticalAlignment="Center"
                                              SelectionChanged="PreviewVideoCombo_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button x:Name="ClearManualButton"
                                            Content="改用自动等分"
                                            Style="{StaticResource ActionButton}"
                                            IsEnabled="False"
                                            Visibility="Collapsed"
                                            Click="ClearManualButton_Click" />
                                    <Button Content="生成预览"
                                            x:Name="GeneratePreviewButton"
                                            Style="{StaticResource ActionButton}"
                                            IsEnabled="False"
                                            Click="GeneratePreviewButton_Click" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1"
                                    Background="#FAFCFE"
                                    BorderBrush="#D8E0E9"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="8"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="PreviewImage"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock x:Name="PreviewEmptyText"
                                               Text="点击“生成预览”查看拼图效果"
                                               Foreground="#9AA9BA"
                                               FontSize="13"
